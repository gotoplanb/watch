{
  "Comment": "Watch per-incident escalation timeline (ADR-001/007). One Standard execution per incident. Each tier is a waitForTaskToken with timeout = tier SLA. ASL orchestrates; Python Lambdas decide and write transitions to Postgres. ${sla_tN_seconds} are rendered by Terragrunt from TIER_SLA_SECONDS.",
  "StartAt": "T1_Wait",
  "States": {
    "T1_Wait": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "TimeoutSeconds": "${sla_t1_seconds}",
      "Parameters": {
        "FunctionName": "${record_token_function_arn}",
        "Payload": {"incidentId.$": "$.incidentId", "tier": "T1", "taskToken.$": "$$.Task.Token"}
      },
      "Catch": [{"ErrorEquals": ["States.Timeout"], "Next": "T1_AutoEscalate"}],
      "Next": "T1_Decision"
    },
    "T1_Decision": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.outcome", "StringEquals": "RESOLVE", "Next": "Resolved"}],
      "Default": "T2_Wait"
    },
    "T1_AutoEscalate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${auto_escalate_function_arn}",
        "Payload": {"incidentId.$": "$.incidentId", "fromTier": "T1"}
      },
      "ResultPath": "$.autoEscalate",
      "Next": "T2_Wait"
    },

    "T2_Wait": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "TimeoutSeconds": "${sla_t2_seconds}",
      "Parameters": {
        "FunctionName": "${record_token_function_arn}",
        "Payload": {"incidentId.$": "$.incidentId", "tier": "T2", "taskToken.$": "$$.Task.Token"}
      },
      "Catch": [{"ErrorEquals": ["States.Timeout"], "Next": "T2_AutoEscalate"}],
      "Next": "T2_Decision"
    },
    "T2_Decision": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.outcome", "StringEquals": "RESOLVE", "Next": "Resolved"}],
      "Default": "T3_Wait"
    },
    "T2_AutoEscalate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${auto_escalate_function_arn}",
        "Payload": {"incidentId.$": "$.incidentId", "fromTier": "T2"}
      },
      "ResultPath": "$.autoEscalate",
      "Next": "T3_Wait"
    },

    "T3_Wait": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "TimeoutSeconds": "${sla_t3_seconds}",
      "Parameters": {
        "FunctionName": "${record_token_function_arn}",
        "Payload": {"incidentId.$": "$.incidentId", "tier": "T3", "taskToken.$": "$$.Task.Token"}
      },
      "Catch": [{"ErrorEquals": ["States.Timeout"], "Next": "EscalationExhausted"}],
      "Next": "T3_Decision"
    },
    "T3_Decision": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.outcome", "StringEquals": "RESOLVE", "Next": "Resolved"}],
      "Default": "EscalationExhausted"
    },

    "Resolved": {
      "Type": "Succeed",
      "Comment": "RESOLVE consumed the token (ADR-007). Clean terminal state — inspectable, no zombie timer."
    },
    "EscalationExhausted": {
      "Type": "Fail",
      "Error": "EscalationExhausted",
      "Cause": "T3 SLA elapsed with no resolution. A missed escalation is a failed execution -> CloudWatch alarm (ADR-001)."
    }
  }
}
