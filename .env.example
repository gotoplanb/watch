# Copy to .env for local development (docker-compose reads this).
# Plain config is inline here; in prod, secrets come from SSM/Secrets Manager
# via the task definition `secrets` block, never inline (spec §4.3).

# Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (RDS Multi-AZ in prod; container locally)
POSTGRES_DB=watch
POSTGRES_USER=watch
POSTGRES_PASSWORD=watch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Valkey (ElastiCache in prod; container locally) — sessions + cache (ADR-008, §4.3)
VALKEY_URL=redis://valkey:6379/0

# AppConfig Agent (ADR-003) — identical localhost:2772 path locally and in Fargate
FLAGS_PROVIDER=memory            # memory | appconfig
APPCONFIG_AGENT_URL=http://appconfig-agent:2772
APPCONFIG_APPLICATION=watch
APPCONFIG_ENVIRONMENT=local
APPCONFIG_PROFILE=flags

# Escalation engine (Step Functions). Empty AWS config => local no-op mode (§5).
AWS_REGION=us-east-1
ESCALATION_STATE_MACHINE_ARN=
ESCALATION_LOCAL_MODE=1          # 1 = log instead of calling AWS (Step Functions Local optional)

# Intake webhook auth (ADR-008) — machine-to-machine shared secret
INTAKE_WEBHOOK_SECRET=dev-webhook-secret

# Tier SLAs (seconds) — timeout on each waitForTaskToken (ADR-007)
SLA_T1_SECONDS=900
SLA_T2_SECONDS=1800
SLA_T3_SECONDS=3600

# SonarQube scan token (local). Generate at http://localhost:9000 and set in .env.
SONAR_TOKEN=

# --- ngrok dev tunnel (local/tunnel) — on-demand public ingress to :8010, never committed ---
# NGROK_API_KEY=          # dashboard -> API keys; used by Terraform to reserve the domain
# NGROK_AUTHTOKEN=        # dashboard -> Your Authtoken; used by the tunnel agent
# TUNNEL_DOMAIN=your-name-watch-dev.ngrok.app   # YOUR reserved host (globally unique per ngrok acct); single source for agent + Terraform
# TUNNEL_BASIC_AUTH_USER=
# TUNNEL_BASIC_AUTH_PASS=
