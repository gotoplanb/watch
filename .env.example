# Copy to .env for local development (docker-compose reads this).
# Plain config is inline here; in prod, secrets come from SSM/Secrets Manager
# via the task definition `secrets` block, never inline (spec §4.3).

# Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (RDS Multi-AZ in prod; container locally)
POSTGRES_DB=watch
POSTGRES_USER=watch
POSTGRES_PASSWORD=watch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Valkey (ElastiCache in prod; container locally) — sessions + cache (ADR-008, §4.3)
VALKEY_URL=redis://valkey:6379/0

# AppConfig Agent (ADR-003) — identical localhost:2772 path locally and in Fargate
FLAGS_PROVIDER=memory            # memory | appconfig
APPCONFIG_AGENT_URL=http://appconfig-agent:2772
APPCONFIG_APPLICATION=watch
APPCONFIG_ENVIRONMENT=local
APPCONFIG_PROFILE=flags

# Conduct (local LLM dispatch) — RCA/tier drafting routes through the Conduct stack
# instead of calling a model directly. Client key is minted in Conduct
# (`conduct clients create watch`); rotate with `conduct clients rotate-key watch`.
# Task types live as routing rules IN Conduct, not here: tier_1, tier_2, tier_3.
# BASE_URL is host.docker.internal from inside the compose network (Conduct's API
# is published on the host at :8000); use http://localhost:8000 if running host-side.
# AI-drafted RCA provider (watch#41): stub | bedrock | conduct. Local dev uses conduct.
RCA_AI_PROVIDER=conduct
# Triage classification (ADR-036) + tier handoff briefs (ADR-040/041) — same seam.
TRIAGE_AI_PROVIDER=conduct
HANDOFF_AI_PROVIDER=conduct

# Async job queue (ADR-025/042). local = no-op (work runs inline, escalate waits on the model);
# thread = run jobs off the request in a daemon thread (local-dev async, NOT durable);
# sqs = hand to the real worker. Handoff briefs use this to get off the escalation hot path.
QUEUE_PROVIDER=thread
CONDUCT_BASE_URL=http://host.docker.internal:8000
CONDUCT_API_KEY=cdt_replace-me           # per-client key; prod: SSM/Secrets Manager, never inline
CONDUCT_TASK_TYPE=tier_2                  # routing rule → model tier in Conduct

# Escalation engine (Step Functions). Empty AWS config => local no-op mode (§5).
AWS_REGION=us-east-1
ESCALATION_STATE_MACHINE_ARN=
ESCALATION_LOCAL_MODE=1          # 1 = log instead of calling AWS (Step Functions Local optional)

# Intake webhook auth (ADR-008) — machine-to-machine shared secret
INTAKE_WEBHOOK_SECRET=dev-webhook-secret

# Ops ingest per-user API keys (ADR-029) — server secret each user's key is HMAC-derived from. Prod: SSM.
API_KEY_SECRET=dev-api-key-secret

# Passwords `make seed_demo` assigns — split so the superuser isn't the same guessable value as the tier
# users. Defaults (watch / admin) are fine purely local; set both to non-guessable values on any
# tunnel-exposed box, then re-run seed_demo to rotate. Superuser is `admin`, tier users t1a..t3b.
SEED_USER_PASSWORD=watch
SEED_ADMIN_PASSWORD=admin

# Tier SLAs (seconds) — timeout on each waitForTaskToken (ADR-007)
SLA_T1_SECONDS=900
SLA_T2_SECONDS=1800
SLA_T3_SECONDS=3600

# SonarQube scan token (local). Generate at http://localhost:9000 and set in .env.
SONAR_TOKEN=

# --- Paging / ntfy (ADR-013) ---
# Secret salt mixed (via HMAC) into paging topic names so they can't be derived from the public
# source. Set to any random string; empty = plain, guessable topics. Prod: an SSM secret.
# After setting it, run `python manage.py paging_topics` to get the exact topics to subscribe to.
# NTFY_TOPIC_SECRET=
# NTFY_BASE_URL=https://ntfy.sh   # self-host or a private server for prod
# NTFY_TOKEN=                     # access token when the server/topics are protected

# --- ngrok dev tunnels (local/tunnel) — on-demand public ingress, never committed ---
# Two tunnels, toggled separately or together: watch -> :8010 (make dev), status -> :5173 (status page).
# NGROK_API_KEY=          # dashboard -> API keys; used by Terraform to reserve the domain(s)
# NGROK_AUTHTOKEN=        # dashboard -> Your Authtoken; used by the tunnel agent
# TUNNEL_DOMAIN=your-name-watch-dev.ngrok.app          # reserved host for the watch tunnel (:8010)
# STATUS_TUNNEL_DOMAIN=your-name-status-dev.ngrok.app  # reserved host for the status tunnel (:5173); optional
# TUNNEL_BASIC_AUTH_USER=
# TUNNEL_BASIC_AUTH_PASS=
