# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Django
*.sqlite3
/backend/staticfiles/
.env*
!.env.example

# Internal example scenarios stay local, including their source references.
/local/fixtures/*
!/local/fixtures/README.md

# Node / frontend
node_modules/
frontend/dist/

# Terraform / Terragrunt
.terraform/
*.tfstate
*.tfstate.*
.terragrunt-cache/

# ngrok dev tunnels (local/tunnel) — rendered creds + per-service runtime files (tfstate covered above)
local/tunnel/policy.local.yml
local/tunnel/policy.*.local.yml
local/tunnel/agent.*.local.yml
local/tunnel/.tunnel.pid
local/tunnel/.tunnel.log
local/tunnel/.tunnel.*.pid
local/tunnel/.tunnel.*.log

# OS / editor
.DS_Store
.idea/
.vscode/
coverage.xml
.scannerwork/

# Private source material and local publication evidence are never source artifacts.
/local/private/
/local/review/
/e2e/report/
/e2e/test-results/
/playwright-report/
/test-results/
*.docx
*.pdf
*.eml
*.har
